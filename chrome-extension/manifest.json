{
  "manifest_version": 3,
  "name": "STANLEY BUSINESS MANAGER",
  "short_name": "StanleyBiz",
  "version": "1.0.0",
  "description": "Record sales, expenses, and orders offline or online, monitor live business profit, and launch your full STANLEY BUSINESS MANAGER workspace from Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "STANLEY BUSINESS MANAGER",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://ais-pre-lg7iq64pqxr4tdimmhmsvz-553917761561.europe-west3.run.app/*",
    "https://ais-dev-lg7iq64pqxr4tdimmhmsvz-553917761561.europe-west3.run.app/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
